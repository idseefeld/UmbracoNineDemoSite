@model UmbracoDemoSite.Core.Features.ContactFormPage.ContactFormPageViewModel
@{
	Layout = "Master.cshtml";
}
@if (Model != null)
{
    @(await Html.PartialAsync("_SectionHeader"))

    if (Model.BodyText != null)
    {
        <section class="section">
            <div class="container">
                @(await Component.InvokeAsync("SubNavigation", new { selected = Model.Id }))
                <div class="col-md-9">
                    <article>
                        @Model.BodyText
                    </article>
                </div>
            </div>
        </section>
    }

    @(await Html.PartialAsync("ContactForm", Model.FormModel))

    @Html.GetBlockListHtml(Model.Blocks)
}