@using Umbraco.Cms.Core.Strings
@using UmbracoDemoSite.Core.Features.Shared.Components.ContactForm
@model UmbracoDemoSite.Core.Features.Page.PageViewModel
@{
    Layout = "Master.cshtml";
}
@if (Model != null)
{
    @(await Html.PartialAsync("_SectionHeader"))

    if (!string.IsNullOrEmpty(Model.BodyText?.ToHtmlString()))
    {
        <section class="section">
            <div class="container">
                @(await Component.InvokeAsync("SubNavigation", new { selected = Model.Id }))
                <div class="col-md-9">
                    <article>
                        @Html.Raw(Model.BodyText)
                    </article>
                </div>
            </div>
        </section>
    }

    @* @(await Component.InvokeAsync("ContactForm", new ContactFormModel())) *@

    @Html.GetBlockListHtml(Model.Blocks)
}